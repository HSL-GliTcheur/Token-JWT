{
  "openapi": "3.0.0",
  "info": {
    "title": "API JWT",
    "version": "1.0.0",
    "description": "test interactif du TP JWT"
  },
  "paths": {
    "/api/login.php": {
      "post": {
        "summary": "Connexion et obtention du token JWT",
        "description": "Route publique. Retourne un jeton JWT valable 15 minutes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "user1@geotech.fr tech1@geotech.fr" },
                  "password": { "type": "string", "example": "password123 secure456" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authentification réussie" },
          "401": { "description": "Identifiants invalides" }
        }
      }
    },
    "/api/me.php": {
      "get": {
        "summary": "Profil utilisateur connecté",
        "description": "Route protégée accessible à tous les rôles.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Données utilisateur récupérées" },
          "401": { "description": "Jeton manquant ou expiré" }
        }
      }
    },
    "/api/admin.php": {
      "post": {
        "summary": "Accès back-office réservé au MANAGER",
        "description": "Route protégée (MANAGER uniquement).",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Accès autorisé" },
          "401": { "description": "Jeton non valide ou absent" },
          "403": { "description": "Droits insuffisants (ex: TECHNICIEN)" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}